[{"kind":"dungeon","size":5,"isNew":true,"status":"Previewed","slug":"hall-of-thanes","name":"The Hall of Thanes","levels":[13,18],"levelSource":"announced","location":"Dun Morogh, beneath old Ironforge","summary":"The burial vaults of Ironforge’s ancient thanes, broken open by Dark Iron looters and engineers. The restless dead have woken with them.","art":"newPower"},{"kind":"dungeon","size":5,"isNew":true,"status":"Previewed","slug":"ruins-of-lordaeron","name":"Ruins of Lordaeron","levels":[15,20],"levelSource":"announced","location":"Tirisfal Glades, the fallen capital","summary":"The shattered throne city above the Undercity, overrun by a necromancer’s invasion: banshees, flesh golems and the Scourge’s fallen champions.","art":"undead"},{"kind":"dungeon","size":5,"isNew":true,"status":"Previewed","slug":"whelgars-excavation","name":"Whelgar’s Excavation","levels":[24,29],"levelSource":"announced","location":"Wetlands, the Explorers’ League dig site","summary":"A titan dig site in the Wetlands where the Explorers’ League dug too deep. Dragonmaw saboteurs, highland beasts and an ancient relic guardian wait below.","notes":["Blizzard’s level list calls it Excavation Site: Wetlands."],"art":"darkshore"},{"kind":"dungeon","size":5,"isNew":true,"status":"Previewed","slug":"city-of-dalaran","name":"City of Dalaran","levels":[28,33],"levelSource":"announced","location":"Alterac, inside the fallen barrier","summary":"The violet city with its great barrier down, now a five-player dungeon in Alterac.","art":"dalaranNight"},{"kind":"dungeon","size":5,"isNew":true,"status":"Announced","slug":"drowned-city","name":"The Drowned City","levels":[35,40],"levelSource":"announced","location":"Stranglethorn Vale","summary":"Sunken troll ruins off the Stranglethorn coast, contested by jungle trolls and naga.","art":"unknownPaths"},{"kind":"dungeon","size":5,"isNew":true,"status":"Announced","slug":"kroldok-stronghold","name":"Krol’dok Stronghold","levels":[40,45],"levelSource":"annou